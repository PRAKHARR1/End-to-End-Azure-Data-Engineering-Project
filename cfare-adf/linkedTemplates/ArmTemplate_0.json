							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"notebookPath": "/Workspace/Users/a81914320@gmail.com/cf/DimSalesResion",
							"baseParameters": {
								"incremental flag": "0"
							}
						},
						"linkedServiceName": {
							"referenceName": "AzureDatabricks1",
							"type": "LinkedServiceReference"
						}
					},
					{
						"name": "Fact_Sales",
						"type": "DatabricksNotebook",
						"dependsOn": [
							{
								"activity": "GoldDimProduct",
								"dependencyConditions": [
									"Succeeded"
								]
							},
							{
								"activity": "GoldDimDate",
								"dependencyConditions": [
									"Succeeded"
								]
							},
							{
								"activity": "GoldDimSalesRegion",
								"dependencyConditions": [
